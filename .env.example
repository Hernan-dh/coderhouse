LLM_PROVIDER=openai

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Generación automática de metadata para commits (Gemini y luego Groq)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_COMMIT_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.5-flash-lite
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
COMMIT_GENERATION_TIMEOUT=15
